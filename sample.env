# =============================================================================
# Smart-Doc unified environment template
# Copy this file to .env at the repo root and fill in your values.
# Loaded by docker-compose for both `fileserver` and `agent` services.
# =============================================================================
# Notes:
#   - PORT is set per-service in docker-compose.yml (fileserver=3000, agent=4111)
#     and is intentionally NOT defined here.
#   - FILESERVER_BASE_URL is overridden per-service in docker-compose.yml so
#     the agent container reaches the fileserver container via Docker DNS.

# -----------------------------------------------------------------------------
# Fileserver runtime
# -----------------------------------------------------------------------------
SOCKET_CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# PostgreSQL (shared by Prisma in fileserver and Mastra storage in agent)
# -----------------------------------------------------------------------------
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/smartdoc

# -----------------------------------------------------------------------------
# S3-compatible object storage (fileserver only)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fileserver
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# NATS JetStream (fileserver only)
# -----------------------------------------------------------------------------
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM=FILE_INGEST
NATS_SUBJECT_INGEST=file.ingest.requested
NATS_CONSUMER=file-ingest-worker
INGEST_MAX_RETRIES=3
INGEST_RETRY_BASE_MS=2000

# -----------------------------------------------------------------------------
# Qdrant (shared)
# -----------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=documents
RAG_VECTOR_SIZE=768
RAG_VECTOR_DISTANCE=Cosine

# -----------------------------------------------------------------------------
# Google Gemini embeddings (shared)
# -----------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBED_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# RAG processing (shared)
# -----------------------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
MAX_FILE_SIZE=10485760
